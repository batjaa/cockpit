{{define "map-fields"}}
{{range .}}<label for="{{.ID}}" class="grid min-w-0 gap-1 text-sm">{{.Label}}{{if .Required}} <span class="text-xs text-[#6E604D]">Required</span>{{end}}
{{if eq .Type "textarea"}}<textarea id="{{.ID}}" name="{{.Name}}" {{if .Required}}required{{end}} {{if .MaxLength}}maxlength="{{.MaxLength}}"{{end}} {{if .ReadOnly}}readonly{{end}} aria-invalid="{{if .Error}}true{{else}}false{{end}}" {{if .Error}}aria-describedby="{{.ID}}-error"{{end}} class="min-h-24 w-full min-w-0 border border-[#C8C3B5] bg-[#FBF8F1] p-3 focus:outline focus:outline-2 focus:outline-[#7A4709]">{{.Value}}</textarea>
{{else if eq .Type "select"}}<select id="{{.ID}}" name="{{.Name}}" aria-invalid="{{if .Error}}true{{else}}false{{end}}" class="min-h-11 w-full min-w-0 border border-[#C8C3B5] bg-[#FBF8F1] px-3 focus:outline focus:outline-2">{{$field := .}}{{range .Options}}<option value="{{.}}" {{if eq . $field.Value}}selected{{end}}>{{.}}</option>{{end}}</select>
{{else}}<input id="{{.ID}}" type="{{.Type}}" name="{{.Name}}" value="{{.Value}}" {{if .Required}}required{{end}} {{if .MaxLength}}maxlength="{{.MaxLength}}"{{end}} {{if .ReadOnly}}readonly{{end}} aria-invalid="{{if .Error}}true{{else}}false{{end}}" {{if .Error}}aria-describedby="{{.ID}}-error"{{end}} class="min-h-11 w-full min-w-0 border border-[#C8C3B5] bg-[#FBF8F1] px-3 read-only:bg-[#ECE6D6] focus:outline focus:outline-2 focus:outline-[#7A4709]">{{end}}
{{if .Error}}<span id="{{.ID}}-error" class="text-sm text-[#7A4709]">{{.Error}}</span>{{end}}</label>{{end}}
{{end}}

{{define "map-workstream-form"}}
<form method="post" action="{{mapPostURL .Query}}" class="mt-5 grid min-w-0 gap-4">
<input type="hidden" name="action" value="create_workstream"><input type="hidden" name="operation_id" value="{{operationID .Form "create_workstream"}}">
{{template "map-fields" .Forms.CreateWorkstream}}
<div class="flex gap-3"><button class="min-h-11 border border-[#1F1B16] bg-[#D88A2C] px-4">Save workstream</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div>
</form>{{end}}

{{define "map-workstream-actions"}}
<details {{if or .Form.Message .Query.UnfinishedCursor}}open{{end}} class="border-b border-[#C8C3B5] bg-[#FBF8F1] px-5 py-3 sm:px-6">
<summary class="min-h-11 cursor-pointer py-2 text-sm font-semibold">Workstream details and lifecycle</summary>
{{if mapActive .Selected}}
<form method="post" action="{{mapPostURL .Query}}" class="mt-3 grid gap-3">
<input type="hidden" name="action" value="edit_workstream"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "edit_workstream" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "edit_workstream"}}">
{{template "map-fields" .Forms.EditWorkstream}}
<div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Save changes</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div></form>
<section class="mt-5 border-t border-[#C8C3B5] pt-4"><h3 class="font-semibold">Complete this outcome</h3><p class="mt-2 text-sm">{{.Unfinished.Total}} unfinished tasks, unresolved asks or concerning signals remain. Completion does not resolve them.</p>
<ul class="mt-2 list-disc pl-5 text-sm">{{range .Unfinished.Rows}}<li><a href="{{mapNav $.Query "item" .ID}}" class="inline-flex min-h-11 items-center break-words underline">{{.Title}} · {{.Kind}} {{.TrackingState}}{{.AskStatus}}{{.Assessment}}</a></li>{{end}}</ul>
<nav class="flex gap-3 text-sm">{{if .Unfinished.PreviousCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "unfinished_cursor" .Unfinished.PreviousCursor}}">Previous unfinished items</a>{{end}}{{if .Unfinished.NextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "unfinished_cursor" .Unfinished.NextCursor}}">Next unfinished items</a>{{end}}</nav>
<form method="post" action="{{mapPostURL .Query}}" class="mt-3 grid gap-3"><input type="hidden" name="action" value="complete_workstream"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "complete_workstream" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "complete_workstream"}}">
{{template "map-fields" .Forms.Completion}}
<label class="flex min-h-11 items-center gap-2 text-sm"><input required type="checkbox" name="confirm"> Confirm completion with the recorded outcome</label>
<div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Complete</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div></form></section>
{{else}}
<p class="mt-3 text-sm">This workstream is read-only while {{if .Selected.Archived}}archived{{else}}completed{{end}}.</p>
{{if .Selected.Archived}}<form method="post" action="{{mapPostURL .Query}}" class="mt-3"><input type="hidden" name="action" value="restore_workstream"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "restore_workstream" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "restore_workstream"}}"><button class="min-h-11 border border-[#C8C3B5] px-3">Restore</button></form>
{{else}}<form method="post" action="{{mapPostURL .Query}}" class="mt-3"><input type="hidden" name="action" value="reopen_workstream"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "reopen_workstream" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "reopen_workstream"}}"><button class="min-h-11 border border-[#C8C3B5] px-3">Reopen</button></form>{{end}}
{{end}}
{{if not .Selected.Archived}}<form method="post" action="{{mapPostURL .Query}}" class="mt-5 border-t border-[#C8C3B5] pt-3"><input type="hidden" name="action" value="archive_workstream"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "archive_workstream" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "archive_workstream"}}"><label class="flex min-h-11 items-center gap-2 text-sm"><input required type="checkbox" name="confirm"> Confirm archive: open obligations leave the active view. History and files are kept.</label><div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Archive</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div></form>{{end}}
</details>{{end}}

{{define "map-item-form"}}
<form method="post" action="{{mapPostURL .Query}}" class="mt-3 grid min-w-0 gap-3" data-map-item-form>
<input type="hidden" name="action" value="create_item"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "create_item" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "create_item"}}">
<label class="grid gap-1 text-sm">Kind<select name="kind" data-map-kind-select class="min-h-11 w-full border border-[#C8C3B5] bg-[#FBF8F1] px-3">{{range slice "task" "reference" "ask" "signal"}}<option value="{{.}}" {{if eq $.Forms.CreateKind .}}selected{{end}}>{{.}}</option>{{end}}</select></label>
<fieldset data-map-source class="grid min-w-0 gap-3"><legend class="sr-only">Item and source context</legend>{{template "map-fields" .Forms.ItemBase}}
<label class="grid gap-1 text-sm">Choose a cached PR<input type="search" data-map-pr-search placeholder="Search repository, PR number or title" class="min-h-11 w-full border border-[#C8C3B5] bg-[#FBF8F1] px-3"></label>
<input type="hidden" name="pr_id" value="{{if eq .Form.Action "create_item"}}{{index .Form.Values "pr_id"}}{{end}}" data-map-pr-id><p data-map-pr-selection class="text-xs text-[#6E604D]">{{if and (eq .Form.Action "create_item") (index .Form.Values "pr_id")}}Cached PR selection retained (ID {{index .Form.Values "pr_id"}}).{{else}}No cached PR selected. Pasted URLs are not fetched.{{end}}</p><div data-map-pr-results aria-live="polite" class="min-w-0"></div></fieldset>
<fieldset data-map-kind="task" class="grid min-w-0 gap-3 border-t border-[#C8C3B5] pt-3"><legend class="font-semibold">Local task</legend>{{template "map-fields" .Forms.ItemTask}}</fieldset>
<fieldset data-map-kind="ask" class="grid min-w-0 gap-3 border-t border-[#C8C3B5] pt-3"><legend class="font-semibold">Cross-team ask</legend>{{template "map-fields" .Forms.ItemAsk}}</fieldset>
<fieldset data-map-kind="signal" class="grid min-w-0 gap-3 border-t border-[#C8C3B5] pt-3"><legend class="font-semibold">Manual signal</legend>{{template "map-fields" .Forms.ItemSignal}}</fieldset>
<div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Save item</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div>
</form>{{end}}

{{define "map-item-detail"}}
<section id="item-detail" class="min-w-0 border-t border-[#C8C3B5] bg-[#FBF8F1] p-5 sm:p-6" aria-labelledby="item-detail-heading">
<h3 id="item-detail-heading" class="break-words text-lg font-semibold">{{.SelectedItem.Kind}}: {{.SelectedItem.Title}}</h3>
<p class="mt-2 whitespace-pre-wrap break-words text-sm">{{.SelectedItem.Description}}</p>
<dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-2 text-sm"><dt>Local state</dt><dd class="min-w-0 break-words">{{if .SelectedItem.DetachedAt}}Detached · {{end}}{{.SelectedItem.TrackingState}}{{.SelectedItem.AskStatus}}{{.SelectedItem.Assessment}}{{if eq .SelectedItem.Kind "reference"}}Context only — not an obligation{{end}}</dd>
{{if .SelectedItem.BlockerReason}}<dt>Blocker</dt><dd class="break-words">{{.SelectedItem.BlockerReason}}</dd>{{end}}{{if .SelectedItem.DueDate}}<dt>Due</dt><dd class="min-w-0 break-words">{{.SelectedItem.DueDate}}</dd>{{end}}{{if .SelectedItem.Counterpart}}<dt>Counterpart</dt><dd class="min-w-0 break-words">{{.SelectedItem.Counterpart}}</dd>{{end}}{{if .SelectedItem.FollowUpAt}}<dt>Follow up</dt><dd class="min-w-0 break-words">{{mapDateTime $.Location .SelectedItem.FollowUpAt}}</dd>{{end}}{{if .SelectedItem.LastContactAt}}<dt>Last contact</dt><dd class="min-w-0 break-words">{{mapDateTime $.Location .SelectedItem.LastContactAt}}</dd>{{end}}
{{if eq .SelectedItem.Kind "signal"}}<dt>Manual observation</dt><dd class="min-w-0 break-words">{{.SelectedItem.Value}} {{.SelectedItem.Unit}}{{if .SelectedItem.ObservedAt}} · {{mapDateTime $.Location .SelectedItem.ObservedAt}}{{else}} · observation unknown{{end}}</dd>{{if .SelectedItem.ReviewBy}}<dt>Review by</dt><dd class="min-w-0 break-words">{{mapDateTime $.Location .SelectedItem.ReviewBy}}</dd>{{end}}{{end}}</dl>
{{with .SelectedItem.Source}}<section class="mt-4 min-w-0 border border-[#C8C3B5] p-3 text-sm"><h4 class="font-semibold">Source context (read-only)</h4><a class="mt-1 block min-h-11 break-words py-2 underline" href="{{.URL}}" target="_blank" rel="noopener noreferrer">{{if .Label}}{{.Label}}{{else}}{{.URL}}{{end}} ↗ external</a>{{if .PRID}}<p class="break-words">{{.CachedTitle}} · cached {{.CachedState}}</p><p class="mt-1 text-xs">Last observed {{if .LastObservedAt}}{{mapDateTime $.Location .LastObservedAt}}{{else}}unknown{{end}}</p>{{if .LocalReviewURL}}<a class="inline-flex min-h-11 items-center underline" href="{{.LocalReviewURL}}">Open cached review</a>{{else}}<p class="mt-2 text-xs">No local review available.</p>{{end}}{{else}}<p class="text-xs">URL reference only. Metadata and freshness are unavailable; this source has not been fetched.</p>{{end}}</section>{{end}}
{{if and (mapActive .Selected) (not .SelectedItem.DetachedAt)}}
<form method="post" action="{{mapPostURL .Query}}" class="mt-4 grid min-w-0 gap-3"><input type="hidden" name="action" value="edit_item"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="item_id" value="{{.SelectedItem.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "edit_item" .SelectedItem.Revision .SelectedItem.ID}}"><input type="hidden" name="operation_id" value="{{operationID .Form "edit_item" .SelectedItem.ID}}"><input type="hidden" name="kind" value="{{.SelectedItem.Kind}}">{{template "map-fields" .Forms.EditItem}}<div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Save item</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div></form>
<form method="post" action="{{mapPostURL .Query}}" class="mt-5 border-t border-[#C8C3B5] pt-3"><input type="hidden" name="action" value="detach_item"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="item_id" value="{{.SelectedItem.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "detach_item" .SelectedItem.Revision .SelectedItem.ID}}"><input type="hidden" name="operation_id" value="{{operationID .Form "detach_item" .SelectedItem.ID}}"><label class="flex min-h-11 items-center gap-2 text-sm"><input required type="checkbox" name="confirm"> Confirm detach. This keeps the item, source and history for restoration.</label><button class="min-h-11 border border-[#C8C3B5] px-3">Detach</button></form>
<form method="post" action="{{mapPostURL .Query}}" data-map-destination data-map-current-workstream="{{.Selected.ID}}" class="mt-5 grid gap-3 border-t border-[#C8C3B5] pt-3"><input type="hidden" name="action" value="move_item"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="item_id" value="{{.SelectedItem.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "move_item" .SelectedItem.Revision .SelectedItem.ID}}"><input type="hidden" name="operation_id" value="{{operationID .Form "move_item" .SelectedItem.ID}}"><label class="grid gap-1 text-sm">Find an active destination<input type="search" data-map-destination-search class="min-h-11 w-full border border-[#C8C3B5] bg-[#FBF8F1] px-3"></label><label class="grid gap-1 text-sm">Move to workstream<select required name="destination_workstream_id" class="min-h-11 w-full border border-[#C8C3B5] bg-[#FBF8F1] px-3"><option value="">Choose an active workstream</option>{{range .MoveDestinations}}{{if ne .ID $.Selected.ID}}<option value="{{.ID}}">{{.Name}}</option>{{end}}{{end}}</select></label><p data-map-destination-status class="text-xs text-[#6E604D]">First 50 active workstreams. Search to narrow the destination. Moves are atomic and keep item identity.</p><div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3">Move</button><a href="{{mapNav .Query}}" class="inline-flex min-h-11 items-center px-3 underline">Cancel</a></div></form>
{{else}}<p class="mt-4 text-sm">{{if .SelectedItem.DetachedAt}}Restore this detached item from the overview before editing it.{{else}}Restore or reopen the parent workstream before editing.{{end}}</p>{{end}}
</section>{{end}}
