{{define "content"}}
{{$f := .Filter}}
<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Sessions</h1>
    <div class="text-xs text-zinc-500 mono mt-1 flex items-center gap-1.5 flex-wrap">
      <span id="visible-count" data-total="{{.Count}}">{{.Count}} session{{if ne .Count 1}}s{{end}}</span>
      {{if .Stale}}
      <span class="text-zinc-300">·</span>
      <span class="text-amber-700">🕳 {{len .Stale}} went quiet mid-work</span>
      {{end}}
      {{if .TrivialHidden}}
      <span class="text-zinc-300">·</span>
      <a href="?{{queryWith $f "all" "1"}}" class="text-zinc-500 hover:text-zinc-900">{{.TrivialHidden}} quick session{{if ne .TrivialHidden 1}}s{{end}} hidden</a>
      {{end}}
      {{if .ShowAll}}
      <span class="text-zinc-300">·</span>
      <a href="?{{queryWith $f "all" ""}}" class="text-zinc-500 hover:text-zinc-900">hide quick sessions</a>
      {{end}}
      {{if .IncludeArchived}}
      <span class="text-zinc-300">·</span>
      <span>including archived</span>
      {{end}}
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <input type="search" id="fuzzy" placeholder="fuzzy filter… (press /)"
           class="text-sm border border-zinc-300 rounded px-3 py-1.5 w-64 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-500">
    <button id="scan-now"
            {{if .Scanning}}data-scanning="true"{{end}}
            class="mono text-xs px-3 py-2 rounded border border-zinc-300 bg-white hover:bg-zinc-100 disabled:opacity-40 disabled:cursor-not-allowed">
      {{if .Scanning}}Scanning…{{else}}Scan now{{end}}
    </button>
  </div>
</div>

{{/* Filter bar: agent + machine chips, active tag pills. */}}
<div class="mb-6 flex items-center gap-1.5 flex-wrap text-xs mono">
  {{range .Agents}}
  <a href="?{{queryWith $f "agent" .Key}}"
     class="px-2 py-1 rounded {{if eq $f.Agent .Key}}{{.Classes}} ring-1 ring-inset ring-zinc-400{{else}}{{.Classes}} opacity-60 hover:opacity-100{{end}}">{{.Label}}</a>
  {{end}}
  {{if .Machines}}<span class="text-zinc-300 mx-1">|</span>
  {{range .Machines}}
  <a href="?{{queryWith $f "machine" .}}"
     class="px-2 py-1 rounded {{if eq $f.Machine .}}bg-zinc-800 text-white{{else}}bg-zinc-100 text-zinc-600 hover:bg-zinc-200{{end}}">{{.}}</a>
  {{end}}{{end}}
  {{if $f.Agent}}<a href="?{{queryWith $f "agent" ""}}" class="px-2 py-1 rounded bg-zinc-200 text-zinc-600 hover:text-zinc-900">agent:{{$f.Agent}} ✕</a>{{end}}
  {{if $f.Machine}}<a href="?{{queryWith $f "machine" ""}}" class="px-2 py-1 rounded bg-zinc-200 text-zinc-600 hover:text-zinc-900">machine:{{$f.Machine}} ✕</a>{{end}}
  {{if $f.Repo}}<a href="?{{queryWith $f "repo" ""}}" class="px-2 py-1 rounded bg-teal-100 text-teal-700 hover:bg-teal-200">repo:{{$f.Repo}} ✕</a>{{end}}
  {{if $f.Branch}}<a href="?{{queryWith $f "branch" ""}}" class="px-2 py-1 rounded bg-emerald-100 text-emerald-700 hover:bg-emerald-200">branch:{{$f.Branch}} ✕</a>{{end}}
  {{if $f.Ticket}}<a href="?{{queryWith $f "ticket" ""}}" class="px-2 py-1 rounded bg-indigo-100 text-indigo-700 hover:bg-indigo-200">{{$f.Ticket}} ✕</a>{{end}}
  {{if $f.Search}}<a href="?{{queryWith $f "q" ""}}" class="px-2 py-1 rounded bg-zinc-200 text-zinc-600 hover:text-zinc-900">“{{$f.Search}}” ✕</a>{{end}}
  <span class="ml-auto">
    {{if .IncludeArchived}}
    <a href="?{{queryWith $f "archived" ""}}" class="text-zinc-500 hover:text-zinc-900">hide archived</a>
    {{else}}
    <a href="?{{queryWith $f "archived" "1"}}" class="text-zinc-500 hover:text-zinc-900">show archived</a>
    {{end}}
  </span>
</div>

{{if .Stale}}
<section class="mb-8" id="stale-section">
  <h2 class="text-sm font-semibold text-amber-800 mb-2 flex items-center gap-2">
    <span>🕳 Went quiet mid-work</span>
    <span class="text-amber-500 font-normal">{{len .Stale}}</span>
  </h2>
  <div class="bg-white rounded-lg border border-amber-300 divide-y divide-zinc-100">
    {{range .Stale}}{{template "session-row" .}}{{end}}
  </div>
</section>
{{end}}

{{if .Buckets}}
<div id="session-list">
  {{range .Buckets}}
  <details class="mb-6" data-bucket {{if .Open}}open{{end}}>
    <summary class="text-xs font-semibold text-zinc-400 uppercase tracking-wide mb-2 cursor-pointer select-none hover:text-zinc-600">
      {{.Label}} <span class="font-normal normal-case">({{len .Cards}})</span>
    </summary>
    <div class="bg-white rounded-lg border border-zinc-200 divide-y divide-zinc-100">
      {{range .Cards}}{{template "session-row" .}}{{end}}
    </div>
  </details>
  {{end}}
</div>
<div id="no-fuzzy-match" class="hidden bg-white rounded-lg border border-zinc-200 p-8 text-center text-sm text-zinc-500">
  Nothing matches the fuzzy filter.
</div>
{{else}}
<div class="bg-white rounded-lg border border-zinc-200 p-12 text-center text-zinc-500">
  <div class="text-sm">No sessions{{if or $f.Agent $f.Machine $f.Ticket $f.Search $f.Repo $f.Branch}} match these filters{{end}}.</div>
  <div class="text-xs mt-3 mono text-zinc-400">Press <span class="font-semibold">Scan now</span> to discover agent sessions.</div>
</div>
{{end}}

<script>
(function() {
  const scanBtn = document.getElementById('scan-now');

  function pollScan() {
    const tick = async () => {
      try {
        const res = await fetch('/sessions/status');
        const data = await res.json();
        if (!data.scanning) { location.reload(); return; }
      } catch (err) { /* network blip; keep polling */ }
      setTimeout(tick, 2000);
    };
    tick();
  }

  if (scanBtn && scanBtn.dataset.scanning === 'true') {
    scanBtn.disabled = true;
    pollScan();
  }

  if (scanBtn) {
    scanBtn.addEventListener('click', async () => {
      scanBtn.disabled = true;
      scanBtn.textContent = 'Scanning…';
      try {
        const res = await fetch('/sessions/scan', {method: 'POST'});
        if (res.status === 409) { pollScan(); return; }
        if (!res.ok) {
          scanBtn.disabled = false;
          scanBtn.textContent = 'Scan now';
          alert('scan failed: ' + (await res.text()));
          return;
        }
        pollScan();
      } catch (err) {
        scanBtn.disabled = false;
        scanBtn.textContent = 'Scan now';
        alert('scan failed: ' + err);
      }
    });
  }

  // --- Fuzzy filter -------------------------------------------------------
  // fzf-style subsequence match: every query char must appear in order in
  // the haystack. Score favors consecutive runs and word-start hits; rows
  // that don't match are hidden. Operates on the server-filtered set, so
  // chips + fuzzy compose.
  function fuzzyScore(hay, q) {
    let hi = 0, score = 0, run = 0;
    for (let qi = 0; qi < q.length; qi++) {
      const c = q[qi];
      let found = -1;
      for (let i = hi; i < hay.length; i++) {
        if (hay[i] === c) { found = i; break; }
      }
      if (found === -1) return -1;
      run = (found === hi && qi > 0) ? run + 1 : 1;
      score += run * 2;
      if (found === 0 || hay[found - 1] === ' ' || hay[found - 1] === '/' || hay[found - 1] === '-') score += 4;
      hi = found + 1;
    }
    return score;
  }

  const fuzzy = document.getElementById('fuzzy');
  const counter = document.getElementById('visible-count');
  const total = counter ? parseInt(counter.dataset.total || '0', 10) : 0;
  function applyFuzzy() {
    const q = fuzzy.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll('[data-session]').forEach(row => {
      const ok = q === '' || fuzzyScore(row.dataset.hay || '', q) >= 0;
      row.classList.toggle('hidden', !ok);
      if (ok) visible++;
    });
    // Hide bucket sections (and the stale box) that lost all their rows;
    // pop collapsed buckets open while a filter is active so matches show.
    document.querySelectorAll('[data-bucket], #stale-section').forEach(sec => {
      const any = sec.querySelector('[data-session]:not(.hidden)');
      sec.classList.toggle('hidden', !any);
      if (q !== '' && any && sec.tagName === 'DETAILS') sec.open = true;
    });
    const none = document.getElementById('no-fuzzy-match');
    if (none) none.classList.toggle('hidden', q === '' || visible > 0);
    if (counter) counter.textContent =
      (q === '' ? total : visible) + ' session' + ((q === '' ? total : visible) === 1 ? '' : 's');
  }
  if (fuzzy) {
    fuzzy.addEventListener('input', applyFuzzy);
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== fuzzy &&
          !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)) {
        e.preventDefault();
        fuzzy.focus();
      }
      if (e.key === 'Escape' && document.activeElement === fuzzy) {
        fuzzy.value = '';
        applyFuzzy();
        fuzzy.blur();
      }
    });
  }

  // Copy-resume buttons.
  document.querySelectorAll('.copy-resume').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.cmd);
        const orig = btn.textContent;
        btn.textContent = 'copied ✓';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      } catch (err) {
        alert('copy failed: ' + err);
      }
    });
  });

  // Archive / unarchive buttons.
  document.querySelectorAll('.archive-toggle').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const archived = btn.dataset.archived === 'true';
      btn.disabled = true;
      try {
        const res = await fetch(`/sessions/${btn.dataset.id}`, {
          method: 'PATCH',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({archived})
        });
        if (!res.ok) {
          btn.disabled = false;
          alert('failed: ' + (await res.text()));
          return;
        }
        const card = btn.closest('[data-session]');
        if (card) {
          card.style.transition = 'opacity .25s';
          card.style.opacity = '0';
          setTimeout(() => card.remove(), 250);
        }
      } catch (err) {
        btn.disabled = false;
        alert('failed: ' + err);
      }
    });
  });
})();
</script>
{{end}}

{{/* One compact session row. Shared by the stale section and the buckets. */}}
{{define "session-row"}}
<div class="group flex items-center gap-3 px-4 py-2 hover:bg-zinc-50" data-session="{{.ID}}" data-hay="{{.Haystack}}">
  <span class="mono text-[10px] px-1.5 py-0.5 rounded shrink-0 {{.AgentClasses}}">{{.Agent}}</span>
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2 min-w-0">
      <span class="text-sm font-medium text-zinc-900 truncate">{{if .Title}}{{.Title}}{{else}}<span class="text-zinc-400">(untitled)</span>{{end}}</span>
      {{if .Stale}}<span class="mono text-[10px] px-1.5 py-0.5 rounded bg-amber-200 text-amber-800 shrink-0">idle {{.IdleDays}}d</span>{{end}}
      {{if .Archived}}<span class="mono text-[10px] px-1.5 py-0.5 rounded bg-zinc-200 text-zinc-500 shrink-0">archived</span>{{end}}
    </div>
    <div class="flex items-center gap-1.5 flex-wrap mono text-[11px] text-zinc-500 mt-0.5">
      {{if and .Machine (ne .Machine "local")}}<a href="?machine={{.Machine}}" class="px-1 rounded bg-zinc-100 text-zinc-600 hover:bg-zinc-200">{{.Machine}}</a>{{end}}
      {{if .Repo}}<a href="?repo={{.Repo}}" class="px-1 rounded bg-teal-50 text-teal-700 hover:bg-teal-100" title="{{.ProjectDir}}">{{.Repo}}</a>{{end}}
      {{if .Branch}}<a href="?branch={{.Branch}}" class="px-1 rounded bg-emerald-50 text-emerald-700 hover:bg-emerald-100 truncate max-w-[16rem]" title="{{.Branch}}">⎇ {{.Branch}}</a>{{end}}
      {{range .Tickets}}<a href="?ticket={{.}}" class="px-1 rounded bg-indigo-50 text-indigo-700 hover:bg-indigo-100">{{.}}</a>{{end}}
      <span class="text-zinc-400">{{.Age}} · {{.MessageCount}} msg{{if ne .MessageCount 1}}s{{end}}</span>
    </div>
  </div>
  <div class="flex items-center gap-1.5 shrink-0 opacity-0 group-hover:opacity-100 transition">
    {{if .IsCursor}}
    <span class="mono text-[11px] px-2 py-1 text-zinc-400" title="Cursor sessions have no CLI resume">open in Cursor</span>
    {{else if .ResumeCmd}}
    <button class="copy-resume mono text-[11px] px-2 py-1 rounded border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:border-zinc-400"
            data-cmd="{{.ResumeCmd}}" title="{{.ResumeCmd}}">copy resume</button>
    {{end}}
    {{if .Archived}}
    <button class="archive-toggle mono text-[11px] px-2 py-1 rounded border border-zinc-200 text-zinc-500 hover:text-zinc-900 hover:border-zinc-400"
            data-id="{{.ID}}" data-archived="false">Unarchive</button>
    {{else}}
    <button class="archive-toggle mono text-[11px] px-2 py-1 rounded border border-zinc-200 text-zinc-500 hover:text-zinc-900 hover:border-zinc-400"
            data-id="{{.ID}}" data-archived="true">Archive</button>
    {{end}}
  </div>
</div>
{{end}}
