{{define "map-overview"}}
<div class="min-w-0 p-5 sm:p-6">
  {{if .Selected.AttentionReasons}}<section aria-labelledby="attention-heading"><h3 id="attention-heading" class="font-mono text-xs font-semibold tracking-wide text-[#7A4709]">WHY IT NEEDS ATTENTION · {{.Selected.AttentionCount}} items</h3><ul class="mt-2 space-y-2">{{range .Selected.AttentionReasons}}<li class="border-l-4 border-[#D88A2C] bg-[#FBF8F1] px-3 py-2 text-sm"><a class="block min-h-11 content-center underline" href="{{if eq .EntityType "workstream"}}{{mapNav $.Query "item" ""}}{{else}}{{mapNav $.Query "item" .EntityID}}{{end}}">[!] {{.Label}}</a></li>{{end}}</ul>{{if .Selected.ReasonsNextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "reasons_cursor" .Selected.ReasonsNextCursor}}">More attention items</a>{{end}}{{if .Query.ReasonsCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "reasons_cursor" ""}}">First attention items</a>{{end}}</section>{{end}}
  {{if .Selected.Warnings}}<section class="mt-4 border border-[#C8C3B5] p-3" aria-label="Data freshness warnings"><h3 class="text-sm font-semibold">Data warnings — separate from attention</h3><ul class="list-disc pl-5 text-sm">{{range .Selected.Warnings}}<li>{{.}}</li>{{end}}</ul></section>{{end}}
  <section class="mt-6"><h3 class="font-mono text-xs font-semibold tracking-wide">RECORDED WORK</h3><p class="mt-2 text-sm">{{.Selected.OpenTaskCount}} open local tasks · {{.Selected.UnresolvedAskCount}} unresolved asks</p><p class="mt-1 text-xs text-[#6E604D]">Needs me: open tasks and open asks below. Waiting and recorded concerns are shown independently.</p>
    {{range .Categories}}<section id="category-{{.Key}}" class="mt-4 min-w-0 border border-[#C8C3B5] bg-[#FBF8F1]"><h4 class="border-b border-[#C8C3B5] bg-[#ECE6D6] px-3 py-3 font-mono text-xs">{{.Label}} · {{.Total}} · {{mapStatus .Attention}} {{if .AttentionCount}}({{.AttentionCount}}){{end}}</h4>
      {{range .Items.Rows}}<a data-map-row href="{{mapNav $.Query "item" .ID "tab" "overview"}}" class="block min-h-11 min-w-0 border-b border-[#C8C3B5] px-3 py-3 hover:bg-[#ECE6D6] focus:outline focus:outline-2"><span class="block break-words font-medium">{{.Title}}</span><span class="block font-mono text-xs text-[#6E604D]">{{.Kind}}{{if .TrackingState}} · {{.TrackingState}}{{end}}{{if .AskStatus}} · {{.AskStatus}}{{end}}{{if .Assessment}} · {{.Assessment}}{{end}}{{if .DueDate}} · due {{.DueDate}}{{end}}</span>{{range .Attention}}<span class="mt-1 block text-xs text-[#7A4709]">[!] {{.Label}}</span>{{end}}{{if .Source}}<span class="mt-1 block truncate text-xs text-[#6E604D]">{{.Source.Label}}{{if .Source.PRID}} · cached {{.Source.CachedState}}{{else}} · URL reference (not fetched){{end}}</span>{{end}}</a>{{else}}<p class="p-3 text-sm text-[#6E604D]">No attached {{lower .Label}} yet.</p>{{end}}
      <nav class="flex flex-wrap gap-4 px-3" aria-label="{{.Label}} pages">{{if .Items.PreviousCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav $.Query "category" .Key "items_cursor" .Items.PreviousCursor}}">Previous 50</a>{{end}}{{if .Items.NextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav $.Query "category" .Key "items_cursor" .Items.NextCursor}}">Next 50</a>{{end}}</nav>
    </section>{{end}}
  </section>
  {{if mapActive .Selected}}<section class="mt-6 border-t border-[#C8C3B5] pt-5"><h3 class="text-lg font-semibold">Add to this workstream</h3><p class="mt-1 text-sm text-[#6E604D]">Add task · Attach reference · Add ask · Record signal</p>{{template "map-item-form" .}}</section><section class="mt-6 border-t border-[#C8C3B5] pt-5"><h3 class="text-lg font-semibold">Record a decision</h3><form method="post" action="{{mapPostURL .Query}}" class="mt-3 grid gap-3"><input type="hidden" name="action" value="record_decision"><input type="hidden" name="workstream_id" value="{{.Selected.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision .Form "record_decision" .Selected.Revision}}"><input type="hidden" name="operation_id" value="{{operationID .Form "record_decision"}}"><label class="grid gap-1 text-sm">Decision or outcome note<textarea required maxlength="32000" name="decision_note" class="min-h-24 border border-[#C8C3B5] bg-[#FBF8F1] p-2">{{if eq .Form.Action "record_decision"}}{{index .Form.Values "decision_note"}}{{end}}</textarea></label><div class="flex gap-3"><button class="min-h-11 border border-[#C8C3B5] px-3 text-sm hover:bg-[#ECE6D6]">Record decision</button><a class="inline-flex min-h-11 items-center px-3 underline" href="{{mapNav .Query}}">Cancel</a></div></form></section>{{end}}
  {{template "map-decisions" .}}
  <section class="mt-6 border-t border-[#C8C3B5] pt-5"><h3 class="font-semibold">Detached items · {{.Detached.Total}}</h3><p class="mt-1 text-sm text-[#6E604D]">Detaching keeps identity, history, and archived Markdown. Restore an item to this workstream.</p>{{range .Detached.Rows}}<div class="mt-3 border border-[#C8C3B5] p-3"><a class="break-words underline" href="{{mapNav $.Query "item" .ID}}">{{.Title}} · {{.Kind}}</a>{{if mapActive $.Selected}}<form method="post" action="{{mapPostURL $.Query}}" class="mt-2"><input type="hidden" name="action" value="restore_item"><input type="hidden" name="operation_id" value="{{operationID $.Form "restore_item" .ID}}"><input type="hidden" name="workstream_id" value="{{$.Selected.ID}}"><input type="hidden" name="item_id" value="{{.ID}}"><input type="hidden" name="expected_revision" value="{{expectedRevision $.Form "restore_item" .Revision .ID}}"><button class="min-h-11 border border-[#C8C3B5] px-3">Restore item</button></form>{{end}}</div>{{else}}<p class="mt-2 text-sm text-[#6E604D]">No detached items.</p>{{end}}<nav class="flex gap-4">{{if .Detached.PreviousCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "detached_cursor" .Detached.PreviousCursor}}">Previous detached items</a>{{end}}{{if .Detached.NextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "detached_cursor" .Detached.NextCursor}}">Next detached items</a>{{end}}</nav></section>
  <section class="mt-6 border-t border-[#C8C3B5] pt-5"><h3 class="font-mono text-xs font-semibold">DRAFTED ACTIONS</h3><p class="mt-2 text-sm text-[#6E604D]">Not available in this module. No model is drafting or sending actions.</p></section>
</div>{{end}}

{{define "map-decisions"}}<section class="mt-6 border-t border-[#C8C3B5] pt-5"><h3 class="font-semibold">Decision history · {{.Selected.DecisionsTotal}}</h3><ol class="mt-3 space-y-3">{{range .Selected.Decisions}}<li id="decision-{{.ID}}" class="border-l-2 border-[#C8C3B5] pl-3"><p class="whitespace-pre-wrap break-words text-sm">{{.Note}}</p><p class="mt-1 font-mono text-xs text-[#6E604D]">{{mapDateTime $.Location .CreatedAt}} · immutable note</p>{{if .ItemID}}<a class="inline-flex min-h-11 items-center text-sm underline" href="{{mapNav $.Query "workstream" .ItemWorkstreamID "item" .ItemID}}">Related item</a>{{end}}</li>{{else}}<li class="text-sm text-[#6E604D]">No decisions recorded yet.</li>{{end}}</ol>{{if .Selected.DecisionsNextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "decisions_cursor" .Selected.DecisionsNextCursor}}">Older decisions</a>{{end}}{{if .Query.DecisionsCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "decisions_cursor" ""}}">Latest decisions</a>{{end}}</section>{{end}}

{{define "map-graph"}}<section class="min-w-0 p-5 sm:p-6"><h3 class="font-mono text-xs font-semibold text-[#7A4709]">ROOT → CATEGORY → ITEM</h3><p class="mt-2 text-sm text-[#6E604D]">A static relationship view. Every item opens the same details as the overview.</p><div tabindex="0" role="region" aria-label="Scrollable relationship graph" class="mt-4 max-h-[36rem] overflow-auto border border-[#C8C3B5] bg-[#FBF8F1]"><svg role="img" aria-label="{{.Selected.Name}} relationship tree" width="760" height="{{.GraphHeight}}" viewBox="0 0 760 {{.GraphHeight}}" class="min-w-[760px]"><title>{{.Selected.Name}}: workstream, categories, and attached items</title>{{range .GraphEdges}}<path d="M {{.X1}} {{.Y1}} H {{.X2}} V {{.Y2}}" fill="none" stroke="#C8C3B5"/>{{end}}{{range .GraphPoints}}<a href="{{.URL}}" aria-label="{{.Kind}}: {{.Label}}"><rect x="{{.X}}" y="{{add .Y -17}}" width="200" height="34" fill="#ECE6D6" stroke="#C8C3B5"/><text x="{{add .X 8}}" y="{{add .Y 4}}" fill="#1F1B16" font-size="12">{{mapShortLabel .Label}}</text><title>{{.Kind}}: {{.Label}}</title></a>{{end}}</svg></div><h4 class="mt-4 font-semibold">Text alternative</h4><ol class="mt-2 list-decimal pl-5 text-sm">{{range .Graph.Nodes}}<li class="break-words py-1">{{if eq .Kind "category"}}{{.Label}}{{else}}<a class="block min-h-11 max-w-full break-words py-3 underline" href="{{if eq .Kind "workstream"}}{{mapNav $.Query "tab" "overview" "item" ""}}{{else}}{{mapNav $.Query "item" .ID "tab" "graph"}}{{end}}">{{.Kind}}: {{.Label}}</a>{{end}}</li>{{end}}</ol>{{if .Graph.Omitted}}<p class="mt-3 text-sm">{{.Graph.Omitted}} items omitted (100-item limit). <a class="underline" href="{{mapNav .Query "tab" "overview"}}">Browse all paginated items</a>.</p>{{end}}</section>{{end}}

{{define "map-timeline"}}<section class="p-5 sm:p-6"><h3 class="font-mono text-xs font-semibold text-[#7A4709]">TIMELINE · {{.Timeline.Total}} local events</h3><ol class="mt-4 border-l border-[#C8C3B5] pl-4">{{range .Timeline.Rows}}<li class="mb-4"><p class="whitespace-pre-wrap break-words text-sm">{{.Description}}</p><p class="font-mono text-xs text-[#6E604D]">{{mapDateTime $.Location .CreatedAt}} · {{.EventType}}</p></li>{{else}}<li class="text-sm text-[#6E604D]">No local changes recorded yet.</li>{{end}}</ol><nav class="flex gap-4" aria-label="Timeline pages">{{if .Timeline.PreviousCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "timeline_cursor" .Timeline.PreviousCursor}}">Newer 50 events</a>{{end}}{{if .Timeline.NextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "timeline_cursor" .Timeline.NextCursor}}">Older 50 events</a>{{end}}</nav>{{template "map-decisions" .}}</section>{{end}}

{{define "map-obsidian"}}<section class="min-w-0 p-5 sm:p-6"><h3 class="font-mono text-xs font-semibold text-[#7A4709]">OBSIDIAN MIRROR</h3><p class="mt-2 text-sm">Saved in Cockpit and synced to vault are separate outcomes. SQLite is authoritative; editing generated Markdown does not update Cockpit.</p>{{if .Mirror.Disabled}}<p class="mt-3 border border-[#C8C3B5] p-3 text-sm">Vault export is disabled. The generated preview remains available; no files are being written.</p>{{end}}
{{range .MirrorPreviews}}<section class="mt-5 min-w-0 border-t border-[#C8C3B5] pt-4"><h4 class="break-words font-semibold">{{.Title}}</h4><p class="mt-1 font-mono text-xs">{{if $.Mirror.Disabled}}disabled{{else}}{{.Status}}{{end}} · desired revision {{.DesiredRevision}} · last successful revision {{.LastSuccessRevision}}</p>{{if .LastSuccessAt}}<p class="mt-1 text-xs">Last synced {{mapDateTime $.Location .LastSuccessAt}}</p>{{end}}{{if .Error}}<p class="mt-3 border-l-4 border-[#D88A2C] pl-3 text-sm">{{.Error}}</p>{{end}}{{if .MirrorStateView.Error}}<p class="mt-3 text-sm">{{.MirrorStateView.Error}}</p>{{end}}
{{if not $.Mirror.Disabled}}<form method="post" action="/map/mirror/retry" class="mt-2"><input type="hidden" name="entity_type" value="{{.EntityType}}"><input type="hidden" name="entity_id" value="{{.EntityID}}"><input type="hidden" name="workstream" value="{{$.Selected.ID}}"><button class="min-h-11 border border-[#C8C3B5] px-3 text-sm">Retry safe export</button><p class="mt-1 text-xs text-[#6E604D]">A conflict requires reconciling or moving the changed file first. Retry never forces overwrite.</p></form>{{end}}
{{if .Markdown}}<label class="mt-3 grid gap-1 text-sm">Markdown location<input readonly data-map-location value="{{.Location}}" class="min-h-11 w-full min-w-0 border border-[#C8C3B5] bg-[#FBF8F1] px-2 font-mono text-xs"></label><p class="mt-1 text-xs text-[#6E604D]">Select and copy this location to open in Obsidian or any text editor. The preview is generated from saved data, not read from the vault.</p><details class="mt-3" open><summary class="min-h-11 cursor-pointer py-3 text-sm font-medium">Generated Markdown preview (read-only)</summary><pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words border border-[#C8C3B5] bg-[#FBF8F1] p-3 font-mono text-xs">{{.Markdown}}</pre></details>{{end}}</section>{{end}}
<h4 class="mt-6 font-semibold">Visible item exports</h4><ul class="mt-2 text-sm">{{range .Categories}}{{range .Items.Rows}}<li><a class="flex min-h-11 flex-wrap items-center justify-between gap-2 border-b border-[#C8C3B5] py-2 underline" href="{{mapNav $.Query "item" .ID "tab" "obsidian"}}"><span class="min-w-0 max-w-full break-words">{{.Title}}</span><span class="font-mono text-xs">{{if $.Mirror.Disabled}}disabled{{else}}{{.Mirror.Status}}{{end}} · rev {{.Mirror.LastSuccessRevision}} / {{.Revision}}</span></a></li>{{end}}{{end}}</ul><p class="mt-2 text-xs text-[#6E604D]">This list follows the current item pages. Use overview pagination for more items, then select one to preview its Markdown.</p>
<h4 class="mt-6 font-semibold">Decision exports</h4>
<p class="mt-2 text-xs text-[#6E604D]">Immutable decisions on this history page have independent export status. A failure does not undo the saved note.</p>
{{range .DecisionExports}}<details class="mt-3 min-w-0 border border-[#C8C3B5] p-3">
<summary class="min-h-11 cursor-pointer break-words py-2 text-sm">Decision · {{mapDateTime $.Location .CreatedAt}} · {{.Mirror.Status}} · rev {{.Mirror.LastSuccessRevision}} / {{.Revision}}</summary>
<p class="mt-2 whitespace-pre-wrap break-words text-sm">{{.Note}}</p>
{{if .Mirror.LastSuccessAt}}<p class="mt-2 text-xs">Last synced {{mapDateTime $.Location .Mirror.LastSuccessAt}}</p>{{end}}
{{if .Mirror.Error}}<p class="mt-2 break-words text-sm text-[#7A4709]">{{.Mirror.Error}}</p>{{end}}
<label class="mt-3 grid min-w-0 gap-1 text-sm">Decision Markdown location<input readonly value="{{.Location}}" class="min-h-11 w-full min-w-0 border border-[#C8C3B5] bg-[#FBF8F1] px-2 font-mono text-xs"></label>
{{if not $.Mirror.Disabled}}<form method="post" action="/map/mirror/retry" class="mt-3"><input type="hidden" name="entity_type" value="decision"><input type="hidden" name="entity_id" value="{{.ID}}"><input type="hidden" name="workstream" value="{{$.Selected.ID}}"><button class="min-h-11 border border-[#C8C3B5] px-3 text-sm">Retry safe decision export</button><p class="mt-1 text-xs">Reconcile or move a conflicting file first. Retry never forces overwrite.</p></form>{{end}}
</details>{{else}}<p class="mt-2 text-sm">No recorded decisions to export.</p>{{end}}
<nav class="mt-2 flex flex-wrap gap-4 text-sm">{{if .Selected.DecisionsNextCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "decisions_cursor" .Selected.DecisionsNextCursor}}">Older decision exports</a>{{end}}{{if .Query.DecisionsCursor}}<a class="inline-flex min-h-11 items-center underline" href="{{mapNav .Query "decisions_cursor" ""}}">Latest decision exports</a>{{end}}</nav>
</section>{{end}}
