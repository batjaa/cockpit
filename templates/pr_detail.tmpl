{{define "content"}}
<a href="/" class="text-sm text-zinc-500 hover:text-zinc-900">← all reviews</a>

<div class="mt-4 mb-8">
  <div class="text-xs text-zinc-500 mono">
    {{.PR.Owner}}/{{.PR.Repo}} #{{.PR.Number}}
    {{if eq .PR.PRState "MERGED"}}<span class="bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded ml-1">merged</span>{{end}}
    {{if eq .PR.PRState "CLOSED"}}<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded ml-1">closed</span>{{end}}
  </div>
  <h1 class="text-2xl font-semibold mt-0.5">{{.PR.Title}}</h1>
  <div class="text-sm text-zinc-500 mt-2 flex items-center gap-2">
    <span>{{.PR.Author}}</span>
    <span class="text-zinc-300">·</span>
    <a href="{{.PR.URL}}" target="_blank" rel="noopener" class="hover:text-zinc-900 underline decoration-zinc-300 underline-offset-2">View on GitHub</a>
    <span class="text-zinc-300">·</span>
    <span class="mono text-xs">{{.HeadShort}}</span>
  </div>
</div>

{{with .ReviewBrief}}
<section class="bg-white border border-zinc-200 rounded-lg p-5 mb-6">
  <div class="flex items-center justify-between gap-3 mb-4">
    <div>
      <h2 class="text-sm font-semibold text-zinc-800">Private review brief</h2>
      <p class="text-xs text-zinc-400 mt-0.5">For your decision only · never posted to GitHub</p>
    </div>
    <span class="mono text-xs rounded px-2 py-1
      {{if eq .RiskLevel "high"}}bg-red-100 text-red-700{{else if eq .RiskLevel "medium"}}bg-amber-100 text-amber-700{{else}}bg-emerald-100 text-emerald-700{{end}}">{{.RiskLevel}} risk</span>
  </div>

  <div>
    <div class="mono text-[10px] uppercase tracking-wide text-zinc-400">What changes</div>
    <div class="mt-1 text-base font-medium text-zinc-900">{{.Change.Intent}}</div>
    <p class="mt-1 text-sm text-zinc-600 leading-relaxed">{{.Change.Mechanism}}</p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 mt-4">
    <div class="rounded-md bg-zinc-50 border border-zinc-100 p-3">
      <div class="mono text-[10px] uppercase tracking-wide text-zinc-400">Why this risk</div>
      <p class="mt-1 text-sm text-zinc-700 leading-relaxed">{{.RiskRationale}}</p>
    </div>
    <div class="rounded-md bg-zinc-50 border border-zinc-100 p-3">
      <div class="mono text-[10px] uppercase tracking-wide text-zinc-400">Blast radius</div>
      <p class="mt-1 text-sm text-zinc-700 leading-relaxed">{{.BlastRadius}}</p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 mt-5">
    <div>
      <h3 class="text-xs font-semibold text-zinc-700">Complex or vulnerable areas</h3>
      {{if .ComplexAreas}}
      <div class="mt-2 space-y-2">
        {{range .ComplexAreas}}
        <div>
          <div class="text-sm font-medium text-zinc-800">{{.Area}}</div>
          <div class="text-xs text-zinc-500 leading-relaxed mt-0.5">{{.Why}}</div>
        </div>
        {{end}}
      </div>
      {{else}}<p class="mt-2 text-xs text-zinc-400">No unusually complex areas identified.</p>{{end}}
    </div>
    <div>
      <h3 class="text-xs font-semibold text-zinc-700">Cross-boundary dependencies</h3>
      {{if .BoundaryChanges}}
      <div class="mt-2 space-y-2">
        {{range .BoundaryChanges}}
        <div>
          <div class="text-sm font-medium text-zinc-800">{{.Boundary}}</div>
          <div class="text-xs text-zinc-500 leading-relaxed mt-0.5">{{.Impact}}</div>
        </div>
        {{end}}
      </div>
      {{else}}<p class="mt-2 text-xs text-zinc-400">No meaningful boundary changes identified.</p>{{end}}
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 mt-5 pt-4 border-t border-zinc-100">
    <div>
      <h3 class="text-xs font-semibold text-zinc-700">Validation</h3>
      <p class="mt-1 text-sm text-zinc-600 leading-relaxed">{{.Validation.Coverage}}</p>
      {{if .Validation.Gaps}}
      <ul class="mt-2 space-y-1 text-xs text-amber-700 list-disc pl-4">
        {{range .Validation.Gaps}}<li>{{.}}</li>{{end}}
      </ul>
      {{end}}
    </div>
    <div>
      <h3 class="text-xs font-semibold text-zinc-700">Uncertainties</h3>
      {{if .Uncertainties}}
      <ul class="mt-2 space-y-1 text-xs text-zinc-600 list-disc pl-4">
        {{range .Uncertainties}}<li>{{.}}</li>{{end}}
      </ul>
      {{else}}<p class="mt-2 text-xs text-zinc-400">No material uncertainties identified.</p>{{end}}
    </div>
  </div>

  {{if .HighLevelConcerns}}
  <div class="mt-5 rounded-md border border-amber-200 bg-amber-50 p-3">
    <h3 class="text-xs font-semibold text-amber-800">High-level concerns</h3>
    <div class="mt-2 space-y-2">
      {{range .HighLevelConcerns}}
      <div>
        <div class="text-sm font-medium text-amber-900">{{.Concern}}</div>
        <div class="text-xs text-amber-800 leading-relaxed mt-0.5">{{.Why}}</div>
      </div>
      {{end}}
    </div>
  </div>
  {{end}}

  <div class="mt-5 pt-4 border-t border-zinc-100">
    <div class="mono text-[10px] uppercase tracking-wide text-zinc-400">Recommendation</div>
    <p class="mt-1 text-sm font-medium text-zinc-800">{{.Recommendation}}</p>
  </div>
</section>
{{else}}
<div class="rounded-lg border border-dashed border-zinc-200 px-4 py-3 mb-6 text-xs text-zinc-500">
  Legacy review · generated before private structured briefs were available.
</div>
{{end}}

{{if eq .State "pending"}}
<section class="bg-white border border-zinc-200 rounded-lg p-5 mb-8">
  <div class="flex items-start justify-between gap-3 mb-2">
    <div>
      <h2 class="text-xs text-zinc-500 uppercase tracking-wide">Author message — posts to GitHub</h2>
      <p class="text-xs text-zinc-400 mt-0.5">Separate from the private brief. Inline findings post independently.</p>
    </div>
    <div class="flex items-center gap-2">
      {{if .LegacyReview}}<span class="mono text-[10px] rounded bg-amber-100 text-amber-700 px-1.5 py-0.5">legacy</span>{{end}}
      <div id="author-message-status" class="text-xs text-zinc-400"></div>
    </div>
  </div>
  {{if .LegacyReview}}
  <div class="text-xs text-amber-700 mb-3">Generated under the old summary contract. Review it before posting.</div>
  {{end}}
  {{if or .HasHighLevelConcern .EditableMessage .LegacyReview}}
  <textarea id="author-message-edit" rows="3"
            placeholder="Write a top-level message addressed to the author…"
            class="w-full text-sm text-zinc-900 leading-relaxed resize-none border-0 p-0 focus:ring-0 focus:outline-none bg-transparent">{{.EditableMessage}}</textarea>
  {{else}}
  <div id="author-message-empty" class="rounded-md border border-dashed border-zinc-200 px-3 py-3 text-sm text-zinc-500">
    No actionable high-level concern, so no author message was generated.
    <button id="add-author-message" type="button" class="block mt-1.5 text-sm text-zinc-900 underline decoration-zinc-300 underline-offset-2">Add a message anyway</button>
  </div>
  <textarea id="author-message-edit" rows="3"
            placeholder="Write a top-level message addressed to the author…"
            class="hidden w-full text-sm text-zinc-900 leading-relaxed resize-none border-0 p-0 focus:ring-0 focus:outline-none bg-transparent"></textarea>
  {{end}}
</section>
{{else if .EditableMessage}}
<section class="bg-white border border-zinc-200 rounded-lg p-5 mb-8">
  <div class="text-xs text-zinc-500 uppercase tracking-wide mb-2">Author message</div>
  <div class="text-sm text-zinc-900 leading-relaxed whitespace-pre-wrap">{{.EditableMessage}}</div>
</section>
{{end}}

{{if .Followups}}
<section class="mb-8">
  <h2 class="text-sm font-semibold text-zinc-700 mb-3">Previous review</h2>
  <div class="bg-white rounded-lg border border-zinc-200 divide-y divide-zinc-100">
    {{range .Followups}}
    <div class="px-4 py-2.5 flex items-start gap-3">
      {{if eq .Status "addressed"}}<span class="mono text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded shrink-0">✓ addressed</span>{{end}}
      {{if eq .Status "outstanding"}}<span class="mono text-xs bg-amber-100 text-amber-700 px-2 py-1 rounded shrink-0">⚠ outstanding</span>{{end}}
      {{if eq .Status "disputed"}}<span class="mono text-xs bg-zinc-100 text-zinc-600 px-2 py-1 rounded shrink-0">✋ disputed</span>{{end}}
      <div class="min-w-0 text-sm">
        <span class="mono text-xs text-zinc-500">{{.Path}}:{{.Line}}</span>
        <span class="text-zinc-900 ml-1.5">{{.Note}}</span>
        {{if .FindingID}}<span class="mono text-xs text-zinc-400 ml-1.5">re-raised as {{.FindingID}}</span>{{end}}
      </div>
    </div>
    {{end}}
  </div>
</section>
{{end}}

<div class="space-y-6">
  {{range .Severities}}
  {{if .Comments}}
  <section>
    <h2 class="text-sm font-semibold text-zinc-700 mb-3 flex items-center gap-2">
      <span>{{.Icon}} {{.Label}}</span>
      <span class="text-zinc-400 font-normal">{{len .Comments}}</span>
    </h2>
    <div class="space-y-2">
      {{range .Comments}}
      <label class="block bg-white border border-zinc-200 rounded-lg p-4 cursor-pointer hover:border-zinc-300 has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-50">
        <div class="flex gap-3">
          <input type="checkbox"
                 class="mt-1.5 comment-toggle accent-zinc-900"
                 data-id="{{.ID}}"
                 {{if .Selected}}checked{{end}}>
          <div class="flex-1 min-w-0">
            <div class="text-xs mono text-zinc-500 mb-1.5">{{.Path}}:{{.Line}}</div>
            {{if .DiffHunkHTML}}<div class="mb-2">{{.DiffHunkHTML}}</div>{{end}}
            <div class="prose prose-sm prose-zinc max-w-none prose-pre:bg-zinc-900 prose-pre:text-zinc-100 prose-code:before:content-none prose-code:after:content-none">{{.BodyHTML}}</div>
          </div>
        </div>
      </label>
      {{end}}
    </div>
  </section>
  {{end}}
  {{end}}
</div>

{{if not .HasAnyComments}}
<div class="bg-white border border-zinc-200 rounded-lg p-12 text-center text-zinc-500 text-sm">
  No findings on this review.
</div>
{{end}}

{{if eq .State "pending"}}
<div class="sticky bottom-0 mt-8 -mx-6 px-6 py-4 bg-white border-t border-zinc-200">
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4 flex-wrap">
    <fieldset class="flex items-center gap-4 text-sm" id="submit-event">
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="event" value="COMMENT" {{if .EditableMessage}}checked{{end}} class="accent-zinc-900"> Comment
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="event" value="APPROVE" {{if not .EditableMessage}}checked{{end}} class="accent-emerald-600"> Approve
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="event" value="REQUEST_CHANGES" class="accent-red-600"> Request changes
      </label>
    </fieldset>
    <div class="flex items-center gap-3">
      <button id="dismiss-btn" class="text-sm text-zinc-500 hover:text-zinc-900">Dismiss review</button>
      <button id="submit-btn" class="mono text-xs px-4 py-2 rounded bg-zinc-900 text-white hover:bg-zinc-700 disabled:opacity-40">
        Submit review
      </button>
    </div>
  </div>
  <p class="max-w-5xl mx-auto mt-2 text-xs text-zinc-400">GitHub requires an author message for Comment and Request changes. Approve can post selected inline findings without one.</p>
  <div id="submit-result" class="max-w-5xl mx-auto mt-2 text-sm hidden"></div>
</div>
{{else}}
<div class="mt-8 bg-zinc-100 border border-zinc-200 rounded-lg px-5 py-3 text-sm text-zinc-600">
  This review is <span class="font-semibold">{{.State}}</span> — no further actions available.
</div>
{{end}}

<script>
document.querySelectorAll('.comment-toggle').forEach(cb => {
  cb.addEventListener('change', async (e) => {
    const id = e.target.dataset.id;
    const selected = e.target.checked;
    const res = await fetch(`/comments/${id}`, {
      method: 'PATCH',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({selected})
    });
    if (!res.ok) {
      e.target.checked = !selected;
      alert('Failed to save: ' + (await res.text()));
    }
  });
});

(function() {
  const ta = document.getElementById('author-message-edit');
  if (!ta) return; // review not pending
  const status = document.getElementById('author-message-status');
  const addBtn = document.getElementById('add-author-message');

  if (addBtn) {
    addBtn.addEventListener('click', () => {
      document.getElementById('author-message-empty').classList.add('hidden');
      ta.classList.remove('hidden');
      ta.focus();
    });
  }

  const autosize = () => { ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px'; };
  autosize();

  let timer = null;
  let lastSaved = ta.value;
  const save = async () => {
    if (ta.value === lastSaved) return;
    status.textContent = 'saving…';
    try {
      const res = await fetch(`/reviews/{{.ReviewID}}`, {
        method: 'PATCH',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({author_message: ta.value})
      });
      if (res.ok) {
        lastSaved = ta.value;
        status.textContent = 'saved';
        status.className = 'text-xs text-emerald-600';
      } else {
        status.textContent = 'save failed: ' + (await res.text());
        status.className = 'text-xs text-red-600';
      }
    } catch (err) {
      status.textContent = 'save failed: ' + err;
      status.className = 'text-xs text-red-600';
    }
  };

  ta.addEventListener('input', () => {
    autosize();
    status.textContent = '';
    clearTimeout(timer);
    timer = setTimeout(save, 800);
  });
  ta.addEventListener('blur', () => { clearTimeout(timer); save(); });

  // Submit must not race the debounce — it awaits this before posting.
  window.flushAuthorMessage = () => { clearTimeout(timer); return save(); };
})();

(function() {
  const submitBtn = document.getElementById('submit-btn');
  const dismissBtn = document.getElementById('dismiss-btn');
  if (!submitBtn) return; // review not pending

  const result = document.getElementById('submit-result');
  const show = (msg, ok) => {
    result.classList.remove('hidden');
    result.className = 'max-w-5xl mx-auto mt-2 text-sm ' + (ok ? 'text-emerald-700' : 'text-red-700');
    result.textContent = msg;
  };

  submitBtn.addEventListener('click', async () => {
    const event = document.querySelector('#submit-event input:checked').value;
    const selected = document.querySelectorAll('.comment-toggle:checked').length;
    const label = event === 'COMMENT' ? 'post ' + selected + ' comment(s)'
                : event.toLowerCase().replace('_', ' ') + ' with ' + selected + ' comment(s)';
    if (!confirm('Submit review to GitHub: ' + label + '?')) return;

    submitBtn.disabled = true;
    try {
      if (window.flushAuthorMessage) await window.flushAuthorMessage();
      const res = await fetch(`/pr/{{.ReviewID}}/submit`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({event})
      });
      const text = await res.text();
      if (!res.ok) {
        show(text, false);
        submitBtn.disabled = false;
        return;
      }
      const data = JSON.parse(text);
      show('Posted ' + data.posted_comments + ' comment(s). Reloading…', true);
      setTimeout(() => location.reload(), 1200);
    } catch (err) {
      show('submit failed: ' + err, false);
      submitBtn.disabled = false;
    }
  });

  dismissBtn.addEventListener('click', async () => {
    // Claim the button before confirm() so a double-fired click can't open
    // a second dialog while the first is still open.
    if (dismissBtn.disabled) return;
    dismissBtn.disabled = true;
    if (!confirm('Dismiss this review? It will disappear from the pending list.')) {
      dismissBtn.disabled = false; // cancelled — allow a retry
      return;
    }
    const res = await fetch(`/pr/{{.ReviewID}}/dismiss`, {method: 'POST'});
    if (res.ok) {
      location.href = '/';
    } else {
      dismissBtn.disabled = false;
      show(await res.text(), false);
    }
  });
})();
</script>
{{end}}
