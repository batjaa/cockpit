{{define "content"}}
<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Pending reviews</h1>
    <div class="text-xs text-zinc-500 mono mt-1 flex items-center gap-1.5 flex-wrap">
      <span>{{len .Reviews}} pending</span>
      {{if .Skipped}}
      <span class="text-zinc-300">·</span>
      <span>{{len .Skipped}} skipped</span>
      {{end}}
      {{with .Stats}}
      <span class="text-zinc-300">·</span>
      <span title="all-time">🏆 {{.PRsReviewed}} PRs reviewed · {{.ReviewsPosted}} posted · {{.CommentsPosted}} comments shipped</span>
      {{end}}
      {{with .LastRun}}
      <span class="text-zinc-300">·</span>
      <span>last run {{.Age}}</span>
      {{if eq .Status "success"}}<span class="text-emerald-700">✓ {{.ReviewCount}} reviewed</span>{{end}}
      {{if eq .Status "partial"}}<span class="text-amber-700">⚠ partial — {{.Error}}</span>{{end}}
      {{if eq .Status "error"}}<span class="text-red-700">✗ {{.Error}}</span>{{end}}
      {{if eq .Status "running"}}<span class="text-zinc-700">running…</span>{{end}}
      {{end}}
      {{if .NextRun}}
      <span class="text-zinc-300">·</span>
      <span>next run {{.NextRun}}</span>
      {{end}}
      {{if gt .StaleSessions 0}}
      <span class="text-zinc-300">·</span>
      <a href="/sessions" class="text-amber-700 hover:underline">🕳 {{.StaleSessions}} stale session{{if ne .StaleSessions 1}}s{{end}} →</a>
      {{end}}
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <form id="manual-review-form" class="flex items-center gap-2">
      <input id="manual-url" type="url" required
             placeholder="https://github.com/owner/repo/pull/123"
             class="text-sm border border-zinc-300 rounded px-3 py-1.5 w-72 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-500">
      <button type="submit" id="manual-review-btn"
              class="mono text-xs px-3 py-2 rounded border border-zinc-300 bg-white hover:bg-zinc-100 disabled:opacity-40">
        Review
      </button>
    </form>
    <button id="run-now"
            {{if .SearchEmpty}}disabled title="set config.search in ~/.cockpit/config.json"{{end}}
            {{if .Running}}data-running="true"{{end}}
            class="mono text-xs px-3 py-2 rounded border border-zinc-300 bg-white hover:bg-zinc-100 disabled:opacity-40 disabled:cursor-not-allowed">
      {{if .Running}}Running…{{else}}Run now{{end}}
    </button>
    <button id="sweep-now"
            title="Dismiss pending reviews for PRs that are merged, closed, or you've already approved on GitHub"
            class="mono text-xs px-3 py-2 rounded border border-zinc-300 bg-white hover:bg-zinc-100 disabled:opacity-40">
      Clear done
    </button>
  </div>
</div>

{{with .LastRun}}
{{if eq .Status "error"}}
<div role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="font-semibold">Review run failed</div>
      <div class="mt-1 mono text-xs whitespace-pre-wrap">{{if .Error}}{{.Error}}{{else}}A dependency failed without an error message.{{end}}</div>
    </div>
    {{if gt .Retryable 0}}
    <button id="retry-failed" data-run="{{.ID}}"
            class="shrink-0 mono text-xs rounded border border-red-300 bg-white px-3 py-1.5 text-red-700 hover:bg-red-100 disabled:opacity-40">
      Retry failed{{if gt .Retryable 1}} ({{.Retryable}}){{end}}
    </button>
    {{end}}
  </div>
</div>
{{end}}
{{end}}

<section id="run-progress" class="hidden mb-8">
  <h2 class="text-sm font-semibold text-zinc-700 mb-3">Current run</h2>
  <div id="run-progress-items" class="bg-white rounded-lg border border-zinc-200 divide-y divide-zinc-100"></div>
</section>

{{if .Reviews}}
<div class="space-y-3">
  {{range .Reviews}}
  <div class="relative bg-white rounded-lg border border-zinc-200 hover:border-zinc-400 transition px-5 py-4" data-card="{{.ReviewID}}">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <div class="text-xs text-zinc-500 mono">
          <a href="{{.URL}}" target="_blank" rel="noopener" class="hover:text-zinc-900 hover:underline">{{.Owner}}/{{.Repo}} #{{.Number}}</a>
          {{if eq .PRState "MERGED"}}<span class="bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded ml-1">merged</span>{{end}}
          {{if eq .PRState "CLOSED"}}<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded ml-1">closed</span>{{end}}
        </div>
        <a href="/pr/{{.ReviewID}}" class="block">
          <div class="font-medium text-zinc-900 truncate mt-0.5">{{.Title}}</div>
          <div class="text-sm text-zinc-500 mt-1">
            {{.Author}}
            {{if .OpenedAge}}
            <span class="text-zinc-300">·</span>
            opened {{.OpenedAge}}
            {{end}}
            {{if .UpdatedAge}}
            <span class="text-zinc-300">·</span>
            updated {{.UpdatedAge}}
            {{end}}
            {{if and (not .OpenedAge) (not .UpdatedAge)}}
            <span class="text-zinc-300">·</span>
            reviewed {{.Age}}
            {{end}}
          </div>
        </a>
        {{$reviewID := .ReviewID}}
        {{with .ReviewBrief}}
        <a href="/pr/{{$reviewID}}" class="block mt-3 rounded-md border border-zinc-200 bg-zinc-50 px-3 py-2.5 hover:border-zinc-300">
          <div class="flex items-center justify-between gap-3">
            <span class="mono text-[10px] uppercase tracking-wide text-zinc-400">Private review brief</span>
            <span class="mono text-[10px] rounded px-1.5 py-0.5
              {{if eq .RiskLevel "high"}}bg-red-100 text-red-700{{else if eq .RiskLevel "medium"}}bg-amber-100 text-amber-700{{else}}bg-emerald-100 text-emerald-700{{end}}">{{.RiskLevel}} risk</span>
          </div>
          <div class="mt-1 text-sm font-medium text-zinc-800 leading-snug">{{.Change.Intent}}</div>
          <div class="mt-1 text-xs text-zinc-500 leading-relaxed">{{.Change.Mechanism}}</div>
          <div class="mt-2 text-xs text-zinc-600 leading-relaxed"><span class="font-medium text-zinc-700">Blast radius:</span> {{.BlastRadius}}</div>
          <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 mono text-[10px] text-zinc-400">
            <span>{{len .ComplexAreas}} complex area{{if ne (len .ComplexAreas) 1}}s{{end}}</span>
            <span>{{len .BoundaryChanges}} boundar{{if eq (len .BoundaryChanges) 1}}y{{else}}ies{{end}}</span>
            <span>{{len .Validation.Gaps}} test gap{{if ne (len .Validation.Gaps) 1}}s{{end}}</span>
            <span class="{{if .HighLevelConcerns}}text-amber-700{{end}}">{{len .HighLevelConcerns}} high-level concern{{if ne (len .HighLevelConcerns) 1}}s{{end}}</span>
          </div>
        </a>
        {{else}}
        <div class="mt-3 text-xs text-zinc-400 rounded-md border border-dashed border-zinc-200 px-3 py-2">
          Legacy review · no private structured brief
        </div>
        {{end}}
      </div>
      <div class="flex flex-col items-end gap-2 shrink-0">
        <div class="flex items-center gap-1.5 text-xs mono">
          {{range .Groups}}
          <div class="relative group/sev">
            <span class="cursor-default px-2 py-1 rounded
              {{if eq .Key "blocker"}}bg-red-100 text-red-700{{else if eq .Key "major"}}bg-orange-100 text-orange-700{{else if eq .Key "minor"}}bg-yellow-100 text-yellow-800{{else}}bg-zinc-100 text-zinc-600{{end}}">{{.Icon}} {{len .Comments}}</span>
            <div class="absolute right-0 bottom-full z-20 hidden group-hover/sev:block pb-1 w-[34rem] max-w-[90vw]">
              <div class="bg-white border border-zinc-300 rounded-lg shadow-xl p-3 text-left">
                <div class="text-xs text-zinc-500 uppercase tracking-wide mb-1.5">{{.Label}} — check to include</div>
                {{range .Comments}}
                <label class="flex items-start gap-2 text-xs cursor-pointer py-1.5 hover:bg-zinc-50 rounded px-1">
                  <input type="checkbox" class="comment-toggle accent-zinc-900 mt-0.5 shrink-0"
                         data-id="{{.ID}}" {{if .Selected}}checked{{end}}>
                  <span class="min-w-0 flex-1">
                    <span class="block mono truncate
                      {{if eq .Severity "blocker"}}text-red-600{{else if eq .Severity "major"}}text-orange-600{{else if eq .Severity "minor"}}text-yellow-700{{else}}text-zinc-400{{end}}"
                      title="{{.Path}}:{{.Line}}">{{.PathShort}}:{{.Line}}</span>
                    {{if .DiffHunkHTML}}<span class="block max-h-40 overflow-y-auto mt-1">{{.DiffHunkHTML}}</span>{{end}}
                    <span class="block text-zinc-700 leading-snug line-clamp-3 mt-0.5">{{.Excerpt}}</span>
                  </span>
                </label>
                {{end}}
              </div>
            </div>
          </div>
          {{end}}
          {{if not .Groups}}<span class="text-zinc-400">no findings</span>{{end}}
        </div>
        <div class="flex items-center gap-2">
          <button class="dismiss-cta mono text-xs px-2.5 py-1 rounded border border-zinc-200 text-zinc-500 hover:text-zinc-900 hover:border-zinc-400 disabled:opacity-40"
                  data-id="{{.ReviewID}}" data-pr="#{{.Number}}">
            Dismiss
          </button>
          <div class="relative group/approve">
            <button class="mono text-xs px-2.5 py-1 rounded border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100">
              Approve
            </button>
            <div class="hidden group-hover/approve:block absolute right-0 bottom-full w-96 z-10 pb-1">
              <div class="bg-white border border-zinc-300 rounded-lg shadow-lg p-3">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <div class="text-xs text-zinc-500 uppercase tracking-wide">Author message — posts to GitHub</div>
                  {{if .LegacyReview}}<span class="mono text-[10px] rounded bg-amber-100 text-amber-700 px-1.5 py-0.5">legacy</span>{{end}}
                </div>
                {{if .LegacyReview}}
                <div class="text-xs text-amber-700 mb-2">Generated under the old summary contract. Review it before posting.</div>
                {{end}}
                {{if or .HasHighLevelConcern .EditableMessage .LegacyReview}}
                <textarea class="approve-author-message w-full text-sm text-zinc-900 leading-snug border border-zinc-200 rounded p-2 resize-none focus:outline-none focus:border-zinc-500"
                          rows="4" data-id="{{.ReviewID}}">{{.EditableMessage}}</textarea>
                {{else}}
                <div class="author-message-empty rounded border border-dashed border-zinc-200 px-3 py-2 text-xs text-zinc-500">
                  No high-level concern, so no message was generated.
                  <button type="button" class="add-author-message block mt-1.5 text-zinc-800 underline decoration-zinc-300 underline-offset-2">Add message anyway</button>
                </div>
                <textarea class="approve-author-message hidden w-full text-sm text-zinc-900 leading-snug border border-zinc-200 rounded p-2 resize-none focus:outline-none focus:border-zinc-500"
                          rows="4" data-id="{{.ReviewID}}" placeholder="Write a top-level message to the author…"></textarea>
                {{end}}
                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-zinc-500"><span class="selected-count" data-card="{{.ReviewID}}">{{.Selected}}</span> comment(s) selected</span>
                  <button class="approve-confirm mono text-xs px-3 py-1.5 rounded bg-emerald-600 text-white hover:bg-emerald-700 disabled:opacity-40"
                          data-id="{{.ReviewID}}" data-pr="#{{.Number}}">
                    Approve ✓
                  </button>
                </div>
                <div class="approve-error text-xs text-red-600 mt-1 hidden" data-card="{{.ReviewID}}"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{end}}
</div>
{{else}}
<div class="bg-white rounded-lg border border-zinc-200 p-12 text-center text-zinc-500">
  <div class="text-sm">No pending reviews yet.</div>
  <div class="text-xs mt-3 mono text-zinc-400">cockpit --pr &lt;url&gt;   or   cockpit --run-once   or click Run now</div>
</div>
{{end}}

{{if .Skipped}}
<section class="mt-10">
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <div>
      <h2 class="text-sm font-semibold text-zinc-700">Skipped</h2>
      <p class="text-xs text-zinc-400 mt-0.5">Listed for visibility; no automated review was generated.</p>
    </div>
    <span class="mono text-xs text-zinc-400">{{len .Skipped}} PR{{if ne (len .Skipped) 1}}s{{end}}</span>
  </div>
  <div class="bg-white rounded-lg border border-zinc-200 divide-y divide-zinc-100">
    {{range .Skipped}}
    <div class="px-5 py-3.5 flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <div class="text-xs text-zinc-400 mono">
          <a href="{{.URL}}" target="_blank" rel="noopener" class="hover:text-zinc-700 hover:underline">{{.Owner}}/{{.Repo}} #{{.Number}}</a>
        </div>
        <div class="font-medium text-zinc-700 truncate mt-0.5">{{.Title}}</div>
        <div class="text-sm text-zinc-400 mt-1">
          {{.Author}}
          {{if .OpenedAge}}
          <span class="text-zinc-300">·</span>
          opened {{.OpenedAge}}
          {{end}}
          {{if .UpdatedAge}}
          <span class="text-zinc-300">·</span>
          updated {{.UpdatedAge}}
          {{end}}
          {{if and (not .OpenedAge) (not .UpdatedAge)}}
          <span class="text-zinc-300">·</span>
          seen {{.SeenAge}}
          {{end}}
        </div>
      </div>
      <span class="shrink-0 mono text-xs rounded bg-zinc-100 text-zinc-500 px-2 py-1" title="No LLM review was generated">skipped · {{.ReasonLabel}}</span>
    </div>
    {{end}}
  </div>
</section>
{{end}}

<script>
(function() {
  const btn = document.getElementById('run-now');
  const form = document.getElementById('manual-review-form');
  const reviewBtn = document.getElementById('manual-review-btn');
  let queueHasWork = false;
  let polling = false;

  function setReviewButton(hasWork) {
    queueHasWork = hasWork;
    if (reviewBtn && !reviewBtn.disabled) {
      reviewBtn.textContent = hasWork ? 'Queue' : 'Review';
    }
  }

  async function fetchRunState() {
    const res = await fetch('/run-status');
    if (!res.ok) throw new Error(await res.text());
    return res.json();
  }

  // Queue state is fetched once on page load. The existing progress poll only
  // starts when there is active work; each enqueue action also refreshes this
  // state immediately so the next submission gets the right verb.
  fetchRunState().then(data => {
    setReviewButton(data.running);
    if (data.running) {
      renderProgress(data.items);
      poll();
    }
  }).catch(() => {
    // Keep the server-rendered default when the one-shot status fetch fails.
  });

  async function refreshAfterAction() {
    try {
      const data = await fetchRunState();
      setReviewButton(data.running);
      if (data.running) {
        renderProgress(data.items);
        poll();
      }
    } catch (_) {
      // The enqueue response succeeded; a transient status failure should not
      // leave the form disabled or prevent another submission.
    }
  }

  if (btn && !btn.disabled) {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Running…';
      try {
        const res = await fetch('/run-now', {method: 'POST'});
        if (!res.ok) {
          btn.textContent = 'Run now';
          btn.disabled = false;
          toast('Run failed: ' + (await res.text()), 'error');
          return;
        }
        const data = await res.json().catch(() => ({status: 'started'}));
        if (data.status === 'duplicate') {
          toast('A run is already in progress — showing its progress.', 'info');
        } else if (data.status === 'queued') {
          const n = data.ahead || 0;
          toast(`Run queued — ${n} ahead. It'll start automatically.`, 'info');
        }
        await refreshAfterAction();
      } catch (err) {
        btn.textContent = 'Run now';
        btn.disabled = false;
        toast('Run failed: ' + err, 'error');
      }
    });
  }

  const retryBtn = document.getElementById('retry-failed');
  if (retryBtn) {
    retryBtn.addEventListener('click', async () => {
      if (retryBtn.disabled) return;
      retryBtn.disabled = true;
      const label = retryBtn.textContent;
      retryBtn.textContent = 'Retrying…';
      try {
        const res = await fetch(`/runs/${retryBtn.dataset.run}/retry-failed`, {method: 'POST'});
        if (!res.ok) {
          retryBtn.disabled = false;
          retryBtn.textContent = label;
          toast('Retry failed: ' + (await res.text()), 'error');
          return;
        }
        const data = await res.json();
        const total = data.queued || 0;
        toast(`${total} failed review${total === 1 ? '' : 's'} queued.`, 'success');
        await refreshAfterAction();
      } catch (err) {
        retryBtn.disabled = false;
        retryBtn.textContent = label;
        toast('Retry failed: ' + err, 'error');
      }
    });
  }

  const sweepBtn = document.getElementById('sweep-now');
  if (sweepBtn) {
    sweepBtn.addEventListener('click', async () => {
      if (sweepBtn.disabled) return;
      sweepBtn.disabled = true;
      const label = sweepBtn.textContent;
      sweepBtn.textContent = 'Clearing…';
      try {
        const res = await fetch('/reconcile', {method: 'POST'});
        if (!res.ok) {
          sweepBtn.textContent = label; sweepBtn.disabled = false;
          toast('Clear failed: ' + (await res.text()), 'error');
          return;
        }
        const data = await res.json().catch(() => ({cleared: 0}));
        if (data.cleared > 0) {
          toast(`Cleared ${data.cleared} done PR${data.cleared === 1 ? '' : 's'} from the list.`, 'success');
          setTimeout(() => location.reload(), 900);
        } else {
          sweepBtn.textContent = label; sweepBtn.disabled = false;
          toast('Nothing to clear — all pending reviews are still open.', 'info');
        }
      } catch (err) {
        sweepBtn.textContent = label; sweepBtn.disabled = false;
        toast('Clear failed: ' + err, 'error');
      }
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('manual-url');
      const url = input.value.trim();
      if (!url) return;
      reviewBtn.disabled = true;
      reviewBtn.textContent = queueHasWork ? 'Queueing…' : 'Starting…';
      try {
        const res = await fetch('/review', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({url})
        });
        if (!res.ok) {
          toast('Review failed: ' + (await res.text()), 'error');
          return;
        }
        const data = await res.json().catch(() => ({status: 'started'}));
        input.value = '';
        if (data.status === 'queued') {
          const n = data.ahead || 0;
          toast(`Review queued — ${n} run${n === 1 ? '' : 's'} ahead. It'll start automatically.`, 'info');
        } else if (data.status === 'duplicate') {
          toast('That PR is already queued or being reviewed.', 'info');
        } else {
          toast('Review started — findings will appear here shortly.', 'success');
        }
        await refreshAfterAction();
      } catch (err) {
        toast('Review failed: ' + err, 'error');
      } finally {
        reviewBtn.disabled = false;
        reviewBtn.textContent = queueHasWork ? 'Queue' : 'Review';
      }
    });
  }

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  function badge(it) {
    switch (it.state) {
      case 'queued':
        return '<span class="mono text-xs bg-zinc-100 text-zinc-500 px-2 py-1 rounded">queued</span>';
      case 'reviewing': {
        const secs = it.started_at ? Math.max(0, Math.round((Date.now() - new Date(it.started_at)) / 1000)) : 0;
        const mins = Math.floor(secs / 60);
        const t = mins > 0 ? `${mins}m${secs % 60}s` : `${secs}s`;
        return `<span class="mono text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded animate-pulse">reviewing… ${t}</span>`;
      }
      case 'done':
        return `<span class="mono text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded">✓ ${it.findings} finding${it.findings === 1 ? '' : 's'}</span>`;
      case 'skipped':
        return '<span class="mono text-xs bg-zinc-100 text-zinc-500 px-2 py-1 rounded">skipped</span>';
      case 'failed':
        return '<span class="mono text-xs bg-red-100 text-red-700 px-2 py-1 rounded">failed</span>';
      default:
        return '';
    }
  }

  function renderProgress(items) {
    const section = document.getElementById('run-progress');
    const list = document.getElementById('run-progress-items');
    if (!items || items.length === 0) {
      // gh discovery still in flight — show the section with a placeholder
      section.classList.remove('hidden');
      list.innerHTML = '<div class="px-4 py-3 text-sm text-zinc-500">Discovering PRs…</div>';
      return;
    }
    section.classList.remove('hidden');
    list.innerHTML = items.map(it => `
      <div class="px-4 py-2.5 flex items-center justify-between gap-3">
        <div class="min-w-0 flex-1">
          <div>
            ${it.owner ? `<span class="mono text-xs text-zinc-500">${esc(it.owner)}/${esc(it.repo)} #${it.number}</span>` : ''}
            ${it.title ? `<span class="text-sm text-zinc-900 ${it.owner ? 'ml-1.5' : ''}">${esc(it.title)}</span>` : ''}
          </div>
          ${it.error ? `<div class="mt-1 text-xs text-red-700">${esc(it.error)}</div>` : ''}
          ${it.reason ? `<div class="mt-1 text-xs text-zinc-500">${esc(it.reason)}</div>` : ''}
        </div>
        <div class="shrink-0">${badge(it)}</div>
      </div>`).join('');
  }

  async function poll() {
    if (polling) return;
    polling = true;
    try {
      while (true) {
        try {
          const data = await fetchRunState();
          renderProgress(data.items);
          if (!data.running) {
            location.reload();
            return;
          }
        } catch (err) {
          // Network blip; keep trying.
        }
        await new Promise(r => setTimeout(r, 2000));
      }
    } finally {
      polling = false;
    }
  }

  // Comment checkboxes inside the hover-expanded panel: persist the
  // selection and keep the popover's selected-count in sync.
  document.querySelectorAll('.comment-toggle').forEach(cb => {
    cb.addEventListener('change', async () => {
      const res = await fetch(`/comments/${cb.dataset.id}`, {
        method: 'PATCH',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({selected: cb.checked})
      });
      if (!res.ok) {
        cb.checked = !cb.checked;
        toast('Failed to save selection: ' + (await res.text()), 'error');
        return;
      }
      const card = cb.closest('[data-card]');
      const count = card.querySelectorAll('.comment-toggle:checked').length;
      const counter = card.querySelector('.selected-count');
      if (counter) counter.textContent = count;
    });
  });

  document.querySelectorAll('.add-author-message').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('[data-card]');
      card.querySelector('.author-message-empty').classList.add('hidden');
      const ta = card.querySelector('.approve-author-message');
      ta.classList.remove('hidden');
      ta.focus();
    });
  });

  // Approve popover: save the optional author message first so submit reads
  // the latest public text. The private brief has no editing or posting path.
  document.querySelectorAll('.approve-confirm').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('[data-card]');
      const ta = card.querySelector('.approve-author-message');
      const errBox = card.querySelector('.approve-error');
      const fail = (msg) => {
        errBox.textContent = msg;
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Approve ✓';
      };
      btn.disabled = true;
      btn.textContent = 'Approving…';
      try {
        const save = await fetch(`/reviews/${btn.dataset.id}`, {
          method: 'PATCH',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({author_message: ta.value})
        });
        if (!save.ok) return fail('author message save failed: ' + (await save.text()));
        const res = await fetch(`/pr/${btn.dataset.id}/submit`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({event: 'APPROVE'})
        });
        if (!res.ok) return fail(await res.text());
        location.reload();
      } catch (err) {
        fail('approve failed: ' + err);
      }
    });
  });

  document.querySelectorAll('.dismiss-cta').forEach(btn => {
    btn.addEventListener('click', async () => {
      // Claim the button synchronously before confirm() so a double-fired
      // click can't open a second dialog while the first is still open.
      if (btn.disabled) return;
      btn.disabled = true;
      if (!confirm(`Dismiss the review for ${btn.dataset.pr}? Nothing posts to GitHub.`)) {
        btn.disabled = false; // cancelled — allow a retry
        return;
      }
      try {
        const res = await fetch(`/pr/${btn.dataset.id}/dismiss`, {method: 'POST'});
        if (!res.ok) {
          toast('Dismiss failed: ' + (await res.text()), 'error');
          btn.disabled = false;
          return;
        }
        location.reload();
      } catch (err) {
        toast('Dismiss failed: ' + err, 'error');
        btn.disabled = false;
      }
    });
  });
})();
</script>
